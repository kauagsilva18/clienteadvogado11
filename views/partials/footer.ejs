  <footer class="footer">
    <div class="container" id="contato">
      <div class="footer-grid">
        <div class="footer-info">
          <h3><%= config.site.logo %></h3>
          <p class="footer-tagline"><%= config.perfil.tagline %></p>
        </div>

        <div class="footer-links">
          <h4>Navegação</h4>
          <a href="#inicio">Início</a>
          <a href="#sobre">Sobre</a>
          <a href="#servicos">Serviços</a>
          <a href="#horarios">Horários</a>
        </div>

        <div class="footer-contact">
          <h4>Contato</h4>
          <div class="social-buttons">
            <a href="<%= config.contato.whatsapp %>" class="btn-social whatsapp" target="_blank" rel="noopener">
              <img src="/images/whatsapp.svg" alt="WhatsApp" class="social-icon"> WhatsApp
            </a>
            <a href="<%= config.contato.instagram %>" class="btn-social instagram" target="_blank" rel="noopener">
              <img src="/images/instagram.svg" alt="Instagram" class="social-icon"> Instagram
            </a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> <%= config.site.logo %>. Todos os direitos reservados.</p>
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
