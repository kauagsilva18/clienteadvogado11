  <footer class="footer">
    <div class="container" id="contato">
      <div class="footer-grid">
        <div class="footer-info">
          <h3><%= config.site.logo %></h3>
          <p class="footer-tagline"><%= config.perfil.tagline %></p>
        </div>

        <div class="footer-links">
          <h4><%= config.rodape.tituloNavegacao %></h4>
          <a href="#inicio"><%= config.navegacao.inicio %></a>
          <a href="#sobre"><%= config.navegacao.sobre %></a>
          <a href="#servicos"><%= config.navegacao.servicos %></a>
          <a href="#horarios"><%= config.navegacao.horarios %></a>
        </div>

        <div class="footer-contact">
          <h4><%= config.rodape.tituloContato %></h4>
          <div class="social-buttons">
            <a href="<%= links.whatsapp %>" class="btn-social whatsapp" target="_blank" rel="noopener">
              <img src="/images/whatsapp.svg" alt="WhatsApp" class="social-icon"> WhatsApp
            </a>
            <a href="<%= links.instagram %>" class="btn-social instagram" target="_blank" rel="noopener">
              <img src="/images/instagram.svg" alt="Instagram" class="social-icon"> Instagram
            </a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> <%= config.site.logo %>. <%= config.rodape.direitos %></p>
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
