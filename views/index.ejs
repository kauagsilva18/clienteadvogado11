<%- include('partials/header') %>

  <main>
    <!-- ===== SEÇÃO INÍCIO / HERO ===== -->
    <section class="hero" id="inicio">
      <div class="hero-bg"></div>
      <div class="container hero-content">
        <div class="profile">
          <div class="profile-photo">
            <% if (config.perfil.foto) { %>
              <img src="<%= config.perfil.foto %>" alt="<%= config.perfil.nome %>">
            <% } else { %>
              <div class="photo-placeholder">
                <span class="scales">⚖</span>
                <span class="placeholder-text">Sua Foto</span>
              </div>
            <% } %>
          </div>
          <div class="profile-info">
            <p class="hero-eyebrow"><%= config.perfil.eyebrow %></p>
            <h1 class="hero-title"><%= config.perfil.nome %></h1>
            <p class="hero-role"><%= config.perfil.titulo %></p>
            <p class="hero-tagline"><%= config.perfil.tagline %></p>
            <div class="hero-cta">
              <a href="#servicos" class="btn btn-primary"><%= config.perfil.botaoServicos %></a>
              <a href="#contato" class="btn btn-outline"><%= config.perfil.botaoContato %></a>
              <a href="<%= links.whatsapp %>" class="btn-whatsapp-icon" target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
                <img src="/images/whatsapp.svg" alt="WhatsApp" class="social-icon">
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== SEÇÃO SOBRE / BIOGRAFIA ===== -->
    <section class="section about" id="sobre">
      <div class="container">
        <p class="section-eyebrow reveal"><%= config.sobre.eyebrow %></p>
        <h2 class="section-title reveal"><%= config.sobre.titulo %></h2>
        <p class="section-text reveal"><%= config.sobre.biografia %></p>
      </div>
    </section>

    <!-- ===== SEÇÃO SERVIÇOS ===== -->
    <section class="section services" id="servicos">
      <div class="container">
        <p class="section-eyebrow reveal"><%= config.servicos.eyebrow %></p>
        <h2 class="section-title reveal"><%= config.servicos.titulo %></h2>
        <div class="services-grid">
          <% config.servicos.lista.forEach(function (servico) { %>
            <div class="service-card reveal">
              <div class="service-icon">
                <%- include('partials/icone', { icone: servico.icone }) %>
              </div>
              <h3 class="service-title"><%= servico.titulo %></h3>
              <p class="service-desc"><%= servico.descricao %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ===== SEÇÃO HORÁRIOS ===== -->
    <section class="section schedule" id="horarios">
      <div class="container">
        <p class="section-eyebrow reveal"><%= config.horarios.eyebrow %></p>
        <h2 class="section-title reveal"><%= config.horarios.titulo %></h2>
        <div class="schedule-list reveal">
          <% config.horarios.lista.forEach(function (item) { %>
            <div class="schedule-item">
              <span class="schedule-day"><%= item.dia %></span>
              <span class="schedule-time"><%= item.horario %></span>
            </div>
          <% }) %>
        </div>
        <div class="schedule-note reveal">
          <p><%= config.horarios.nota %></p>
          <a href="<%= links.whatsapp %>" class="btn btn-whatsapp" target="_blank" rel="noopener">
            <img src="/images/whatsapp.svg" alt="WhatsApp" class="social-icon"> <%= config.horarios.botaoWhatsapp %>
          </a>
        </div>
      </div>
    </section>
  </main>

<%- include('partials/footer') %>
