<%- include('partials/header') %>

  <main>
    <!-- ===== SEÇÃO INÍCIO / HERO ===== -->
    <section class="hero" id="inicio">
      <div class="hero-bg"></div>
      <div class="container hero-content">
        <div class="profile">
          <div class="profile-photo">
            <% if (config.perfil.foto) { %>
              <img src="/images/<%= config.perfil.foto %>" alt="<%= config.perfil.nome %>">
            <% } else { %>
              <div class="photo-placeholder">
                <span class="scales">⚖</span>
                <span class="placeholder-text">Sua Foto</span>
              </div>
            <% } %>
          </div>
          <div class="profile-info">
            <p class="hero-eyebrow">Advocacia</p>
            <h1 class="hero-title"><%= config.perfil.nome %></h1>
            <p class="hero-role"><%= config.perfil.titulo %></p>
            <p class="hero-tagline"><%= config.perfil.tagline %></p>
            <div class="hero-cta">
              <a href="#servicos" class="btn btn-primary">Conheça os Serviços</a>
              <a href="#contato" class="btn btn-outline">Entre em Contato</a>
              <a href="<%= config.contato.whatsapp %>" class="btn-whatsapp-icon" target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
                <img src="/images/whatsapp.svg" alt="WhatsApp" class="social-icon">
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== SEÇÃO SOBRE / BIOGRAFIA ===== -->
    <section class="section about" id="sobre">
      <div class="container">
        <p class="section-eyebrow reveal">Quem sou</p>
        <h2 class="section-title reveal"><%= config.sobre.titulo %></h2>
        <p class="section-text reveal"><%= config.sobre.biografia %></p>
      </div>
    </section>

    <!-- ===== SEÇÃO SERVIÇOS ===== -->
    <section class="section services" id="servicos">
      <div class="container">
        <p class="section-eyebrow reveal">Especialidades</p>
        <h2 class="section-title reveal"><%= config.servicos.titulo %></h2>
        <div class="services-grid">
          <% config.servicos.lista.forEach(function (servico) { %>
            <div class="service-card reveal">
              <div class="service-icon">
                <% if (servico.icone === 'icon-guarda.svg') { %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M17.9999 18.7191C18.2474 18.7396 18.4978 18.75 18.7506 18.75C19.7989 18.75 20.8054 18.5708 21.741 18.2413C21.7473 18.1617 21.7506 18.0812 21.7506 18C21.7506 16.3431 20.4074 15 18.7506 15C18.123 15 17.5403 15.1927 17.0587 15.5222M17.9999 18.7191C18 18.7294 18 18.7397 18 18.75C18 18.975 17.9876 19.1971 17.9635 19.4156C16.2067 20.4237 14.1707 21 12 21C9.82933 21 7.79327 20.4237 6.03651 19.4156C6.01238 19.1971 6 18.975 6 18.75C6 18.7397 6.00003 18.7295 6.00008 18.7192M17.9999 18.7191C17.994 17.5426 17.6494 16.4461 17.0587 15.5222M17.0587 15.5222C15.9928 13.8552 14.1255 12.75 12 12.75C9.87479 12.75 8.00765 13.8549 6.94169 15.5216M6.94169 15.5216C6.46023 15.1925 5.87796 15 5.25073 15C3.59388 15 2.25073 16.3431 2.25073 18C2.25073 18.0812 2.25396 18.1617 2.26029 18.2413C3.19593 18.5708 4.2024 18.75 5.25073 18.75C5.50307 18.75 5.75299 18.7396 6.00008 18.7192M6.94169 15.5216C6.35071 16.4457 6.00598 17.5424 6.00008 18.7192M15 6.75C15 8.40685 13.6569 9.75 12 9.75C10.3431 9.75 9 8.40685 9 6.75C9 5.09315 10.3431 3.75 12 3.75C13.6569 3.75 15 5.09315 15 6.75ZM21 9.75C21 10.9926 19.9926 12 18.75 12C17.5074 12 16.5 10.9926 16.5 9.75C16.5 8.50736 17.5074 7.5 18.75 7.5C19.9926 7.5 21 8.50736 21 9.75ZM7.5 9.75C7.5 10.9926 6.49264 12 5.25 12C4.00736 12 3 10.9926 3 9.75C3 8.50736 4.00736 7.5 5.25 7.5C6.49264 7.5 7.5 8.50736 7.5 9.75Z" /></svg>
                <% } else if (servico.icone === 'icon-visitas.svg') { %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M16 2v4" /><path d="M8 2v4" /><path d="M3 10h18" /><path d="m9 16 2 2 4-4" /></svg>
                <% } else if (servico.icone === 'icon-divorcio.svg') { %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /><path d="m12 13-1-1 2-2-1-1" /></svg>
                <% } else if (servico.icone === 'icon-paternidade.svg') { %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 12h.01" /><path d="M15 12h.01" /><path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5" /><path d="M19 6.3a9 9 0 0 1 1.8 3.9 2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1" /></svg>
                <% } else if (servico.icone === 'icon-pensao.svg') { %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="20" height="12" x="2" y="6" rx="2" /><circle cx="12" cy="12" r="2" /><path d="M6 12h.01" /><path d="M18 12h.01" /></svg>
                <% } else if (servico.icone === 'icon-honra.svg') { %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" /></svg>
                <% } else if (servico.icone === 'icon-consumidor.svg') { %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="20" height="14" x="2" y="5" rx="2" /><path d="M2 10h20" /><path d="m9 15 2 2 4-4" /></svg>
                <% } else if (servico.icone === 'icon-protetiva.svg') { %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="M12 9.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" /><path d="M6.5 18.5a5.5 5.5 0 0 1 11 0" /></svg>
                <% } else { %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3V20.25M12 20.25C10.528 20.25 9.1179 20.515 7.81483 21M12 20.25C13.472 20.25 14.8821 20.515 16.1852 21M18.75 4.97089C16.5446 4.66051 14.291 4.5 12 4.5C9.70897 4.5 7.45542 4.66051 5.25 4.97089M18.75 4.97089C19.7604 5.1131 20.7608 5.28677 21.75 5.49087M18.75 4.97089L21.3704 15.6961C21.4922 16.1948 21.2642 16.7237 20.7811 16.8975C20.1468 17.1257 19.4629 17.25 18.75 17.25C18.0371 17.25 17.3532 17.1257 16.7189 16.8975C16.2358 16.7237 16.0078 16.1948 16.1296 15.6961L18.75 4.97089ZM2.25 5.49087C3.23922 5.28677 4.23956 5.1131 5.25 4.97089M5.25 4.97089L7.87036 15.6961C7.9922 16.1948 7.76419 16.7237 7.28114 16.8975C6.6468 17.1257 5.96292 17.25 5.25 17.25C4.53708 17.25 3.8532 17.1257 3.21886 16.8975C2.73581 16.7237 2.5078 16.1948 2.62964 15.6961L5.25 4.97089Z" /></svg>
                <% } %>
              </div>
              <h3 class="service-title"><%= servico.titulo %></h3>
              <p class="service-desc"><%= servico.descricao %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ===== SEÇÃO HORÁRIOS ===== -->
    <section class="section schedule" id="horarios">
      <div class="container">
        <p class="section-eyebrow reveal">Atendimento</p>
        <h2 class="section-title reveal"><%= config.horarios.titulo %></h2>
        <div class="schedule-list reveal">
          <% config.horarios.lista.forEach(function (item) { %>
            <div class="schedule-item">
              <span class="schedule-day"><%= item.dia %></span>
              <span class="schedule-time"><%= item.horario %></span>
            </div>
          <% }) %>
        </div>
        <div class="schedule-note reveal">
          <p>Para agendar uma consulta, entre em contato pelo botão abaixo.</p>
          <a href="<%= config.contato.whatsapp %>" class="btn btn-whatsapp" target="_blank" rel="noopener">
            <img src="/images/whatsapp.svg" alt="WhatsApp" class="social-icon"> Fale comigo no WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

<%- include('partials/footer') %>
